{
  "metadata": { "name": "etcd-trend-workbench", "attempt": 0 },
  "image": { "image": "ghcr.io/yckao/etcd-trend:latest" },
  "command": ["/bin/sleep"],
  "args": ["infinity"],
  "envs": [ { "key": "TERM", "value": "xterm-256color" } ],
  "log_path": "workbench.log",
  "mounts": [
    { "host_path": "/srv/etcd-trend/captures", "container_path": "/captures", "readonly": true, "selinux_relabel": false },
    { "host_path": "/srv/etcd-trend/runs", "container_path": "/runs", "readonly": false, "selinux_relabel": false },
    { "host_path": "/srv/etcd-trend/tmp-offline", "container_path": "/tmp", "readonly": false, "selinux_relabel": false }
  ],
  "linux": {
    "security_context": {
      "run_as_user": { "value": 0 },
      "run_as_group": { "value": 0 },
      "readonly_rootfs": true,
      "no_new_privs": true,
      "capabilities": { "drop_capabilities": ["ALL"] }
    }
  }
}
